generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DraftKey {
  athleteId String @id
  keyId     String @unique @db.Uuid
  key       Bytes
}

model OperationReceipt {
  athleteId          String
  operationId        String @db.Uuid
  recoveryGeneration String
  commandHash        String
  revision           String
  result             Json

  @@id([athleteId, operationId])
}

model Athlete {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  email           String
  normalizedEmail String   @unique
  passwordHash    String?
  accessRevision  Int      @default(1)
  createdAt       DateTime @default(now())
  diary           Diary?
  sessions        AuthSession[]
  recoveries      PasswordRecovery[]
}

model Diary {
  id        String  @id @default(uuid()) @db.Uuid
  athleteId String  @unique @db.Uuid
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model PendingEmailAction {
  id              String    @id @default(uuid()) @db.Uuid
  purpose         String
  tokenHash       String    @unique
  normalizedEmail String
  email           String
  name            String
  passwordHash    String
  expiresAt       DateTime
  deliveredAt     DateTime?
  consumedAt      DateTime?
  cancelledAt     DateTime?
  attemptHash     String
  createdAt       DateTime  @default(now())

  @@index([normalizedEmail, purpose])
}

model AuthSession {
  tokenHash       String   @id
  athleteId       String   @db.Uuid
  athlete         Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  csrfHash        String
  accessRevision  Int
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([athleteId])
}

model AuthAttempt {
  tokenHash String   @id
  csrfHash  String
  expiresAt DateTime
}

model AuthRateBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

model PasswordRecovery {
  id              String    @id @default(uuid()) @db.Uuid
  purpose         String    @default("recovery")
  tokenHash       String    @unique
  normalizedEmail String
  athleteId       String?   @db.Uuid
  athlete         Athlete?  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  accessRevision  Int?
  attemptHash     String
  expiresAt       DateTime
  deliveredAt     DateTime?
  deliveryFailedAt DateTime?
  consumedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([athleteId])
}
