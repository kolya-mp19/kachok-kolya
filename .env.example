# Copy this file to .env (production) or .env.local (local dev) and fill in real values.
# Never commit .env or .env.local — they contain secrets.
# This file (.env.example) IS committed as a template.

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL consumed by Drizzle ORM and postgres-js.
# Local dev:   postgresql://kachok:kachok_dev@localhost:5432/kachok
# Production:  postgresql://kachok:changeme@postgres:5432/kachok
#              (postgres = Docker Compose service name, resolved by internal DNS)
DATABASE_URL=postgresql://kachok:changeme@postgres:5432/kachok

# Individual vars used by docker-compose.yml to initialise the Postgres container.
# Must match the credentials in DATABASE_URL above.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kachok
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kachok

# ─── JWT ───────────────────────────────────────────────────────────────────────
# HMAC-SHA256 signing keys for access and refresh tokens. Must be different.
# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Token lifetimes — jose duration string format: <number><unit> (s, m, h, d)
# Access token should be short; refresh token can be longer.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App URL ───────────────────────────────────────────────────────────────────
# Full base URL used to build OAuth callback redirect URIs.
# Local dev:   http://localhost:3000
# Production:  https://your-domain.com
APP_URL=http://localhost:3000

# ─── Yandex OAuth ──────────────────────────────────────────────────────────────
# Create an app at https://oauth.yandex.ru/client/new
# Callback URL to register: {APP_URL}/api/auth/yandex/callback
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

# ─── VK OAuth ──────────────────────────────────────────────────────────────────
# Create an app at https://vk.com/editapp?act=create (type: Website)
# Callback URL to register: {APP_URL}/api/auth/vk/callback
# Required permissions: email
VK_CLIENT_ID=your-vk-client-id
VK_CLIENT_SECRET=your-vk-client-secret

# ─── Runtime ───────────────────────────────────────────────────────────────────
# Controls secure cookie flag (secure: true only in production) and DB singleton
# behaviour in Next.js dev hot-reload.
NODE_ENV=development
