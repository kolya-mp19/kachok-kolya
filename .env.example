# Copy this file to .env (production) or .env.local (local dev) and fill in real values.
# Never commit .env or .env.local — they contain secrets.
# This file (.env.example) IS committed as a template.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────

# Production  → postgres  (Docker Compose service name — internal DNS)
# Local dev   → localhost (port exposed from src/env/local/docker-compose.yml)
POSTGRES_HOST=postgres

POSTGRES_PORT=5432
POSTGRES_USER=kachok
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kachok

# Full connection URL used by the ORM (Prisma / Drizzle).
# Production:  postgresql://kachok:changeme@postgres:5432/kachok
# Local dev:   postgresql://kachok:kachok_dev@localhost:5432/kachok
DATABASE_URL=postgresql://kachok:changeme@postgres:5432/kachok
