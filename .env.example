# Локальная оболочка не требует обязательных параметров или секретов.
# Необязательный порт NestJS; Vite автоматически использует его для /api.
PORT=3000
# Сервер всегда привязан к 127.0.0.1. Внешний доступ не настраивается в E004.
# Не добавляйте серверные секреты с префиксом VITE_: такие значения публичны.
# Только синтетическая локальная БД из compose.yaml. Оболочка и калькулятор
# запускаются без БД; команды db:* требуют DATABASE_URL.
DATABASE_URL=postgresql://kachok:local-only-password@127.0.0.1:54329/kachok_local
# Адрес приложения для проверки Origin и ссылок писем, никогда не берётся из Host.
# Для npm start укажите http://127.0.0.1:3000.
APP_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Необязательный защищённый Vite для телефона: см. docs/local-email-access.md.
# LOCAL_HTTPS_HOST=192.168.1.10
# LOCAL_HTTPS_CERT=.local-certs/app.pem
# LOCAL_HTTPS_KEY=.local-certs/app-key.pem
