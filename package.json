{
  "name": "kachok-kolya",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check": "node scripts/check.mts",
    "format": "prettier --write apps contracts scripts tests vite.config.mts prisma.config.ts",
    "format:check": "prettier --check apps contracts scripts tests vite.config.mts prisma.config.ts",
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "build": "npm run db:generate && npm run typecheck && tsc -p apps/api/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/storage.mts migrate",
    "db:status": "tsx --env-file-if-exists=.env scripts/storage.mts status",
    "db:check": "tsx --env-file-if-exists=.env scripts/storage.mts check"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "antd": "6.7.0",
    "express": "5.3.0",
    "nodemailer": "^10.5.0",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
