{
  "name": "kachok-kolya",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "build": "npm run typecheck && tsc -p apps/api/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "antd": "6.7.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
