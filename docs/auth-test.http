# Auth Integration Test Suite
# VS Code REST Client — https://marketplace.visualstudio.com/items?itemName=humao.rest-client
#
# How to use:
#   1. Install the "REST Client" VS Code extension (humao.rest-client)
#   2. Start the app:  npm run dev
#   3. Start Postgres:  docker compose up -d  (or your local setup)
#   4. Click "Send Request" above any ### block
#
# Cookie handling:
#   REST Client uses a built-in cookie jar. Cookies from Set-Cookie response
#   headers are stored and sent automatically on subsequent requests to the
#   same host, respecting path restrictions.
#   The refresh_token cookie (path=/api/auth/refresh) will only be sent to
#   Step 3 — exactly mirroring real browser behaviour.
#
# Run order: Steps 1 → 7 in sequence (each step depends on the prior state).
# Error cases at the bottom are standalone — run them independently.

@host = http://localhost:3000
@email = tester@example.com
@password = TestPass123!
@name = Integration Tester


# ══════════════════════════════════════════════════════════════════════════════
# HAPPY PATH
# ══════════════════════════════════════════════════════════════════════════════

### Step 1 — Register
# Expected:  201 Created
#            Body:    { "user": { "id": "...", "email": "...", "name": "..." } }
#            Cookies: access_token (path=/)
#                     refresh_token (path=/api/auth/refresh)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "{{name}}"
}


### Step 2 — Get profile (access token valid)
# Expected:  200 OK
#            Body: { "user": { "id", "email", "name", "gender", "createdAt" } }
# Sends:     access_token cookie (no refresh_token — path mismatch)
GET {{host}}/api/auth/me


### Step 3 — Refresh tokens
# Expected:  200 OK
#            Body: { "success": true }
#            Cookies: new access_token + new refresh_token (old pair invalidated in DB)
# Sends:     access_token AND refresh_token (path=/api/auth/refresh matches this URL)
POST {{host}}/api/auth/refresh


### Step 4 — Get profile after refresh
# Expected:  200 OK — same user, new access token being used
GET {{host}}/api/auth/me


### Step 5 — Logout
# Expected:  200 OK
#            Body: { "success": true }
#            Cookies: access_token cleared (MaxAge=0)
#                     refresh_token cleared (MaxAge=0, path=/api/auth/refresh)
#            DB:    all refresh_tokens rows for this user deleted
POST {{host}}/api/auth/logout


### Step 6 — Get profile after logout (expect 401)
# Expected:  401 Unauthorized
#            Body: { "error": "Unauthorized", "code": "NO_TOKEN" }
# Verify:    cookies are gone — no access_token sent
GET {{host}}/api/auth/me


### Step 7 — Login again
# Expected:  200 OK
#            Body:    { "user": { "id", "email", "name" } }
#            Cookies: access_token + refresh_token restored
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


# ══════════════════════════════════════════════════════════════════════════════
# ERROR CASES  (run independently — each is self-contained)
# ══════════════════════════════════════════════════════════════════════════════

### Error — Register duplicate email
# Expected: 409 Conflict
#           Body: { "error": "Email already in use", "code": "EMAIL_TAKEN" }
# Pre-condition: Step 1 must have been completed first
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "{{name}}"
}


### Error — Register short password
# Expected: 400 Bad Request
#           Body: { "error": "Password must be at least 8 characters" }
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "new@example.com",
  "password": "short",
  "name": "Bob"
}


### Error — Register missing name
# Expected: 400 Bad Request
#           Body: { "error": "Name is required" }
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "new@example.com",
  "password": "ValidPass123!"
}


### Error — Login wrong password
# Expected: 401 Unauthorized
#           Body: { "error": "Invalid credentials" }
# Note:     Same response shape as unknown email (timing-safe — prevents enumeration)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "WrongPassword999!"
}


### Error — Login unknown email
# Expected: 401 Unauthorized
#           Body: { "error": "Invalid credentials" }
#           Timing: ~same latency as wrong password (DUMMY_HASH prevents oracle)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "{{password}}"
}


### Error — Refresh without cookie
# Expected: 401 Unauthorized
#           Body: { "error": "Refresh token missing", "code": "NO_TOKEN" }
# Note:     Clear cookies in REST Client or open in a private window to test
POST {{host}}/api/auth/refresh


### Error — Register invalid gender value
# Expected: 400 Bad Request
#           Body: { "error": "Gender must be \"male\" or \"female\"" }
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "gender@example.com",
  "password": "ValidPass123!",
  "name": "Gender Test",
  "gender": "other"
}


### Register with gender (valid)
# Expected: 201 Created — gender field stored
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "gendered@example.com",
  "password": "ValidPass123!",
  "name": "Gendered User",
  "gender": "male"
}
